<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>konarm_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface for the SDRAC KonArm robot arm</description>
  <maintainer email="dodpat02@gmail.com">Patryk Dudziński</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>konarm_driver</depend>
  <depend>can_device</depend>
  <depend>ari_shared_types</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
